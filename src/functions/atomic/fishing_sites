"""Module for phishing sites checking functionality."""

import os
import logging
from typing import List
import requests
import telebot
from telebot import types
from telebot.callback_data import CallbackData
from bot_func_abc import AtomicBotFunctionABC

class PhishingCheckerFunction(AtomicBotFunctionABC):
    """Implementation of phishing sites checking functionality"""

    commands: List[str] = ["phishing", "phish"]
    authors: List[str] = ["Your Name"]
    about: str = "Проверка фишинговых сайтов"
    description: str = """Доступные команды:
    /phishing latest [N] - показать последние N фишинговых сайтов
    /phishing country [CODE] [N] - показать N сайтов по стране
    Примеры:
    /phishing latest 5
    /phishing country RU 3"""
    state: bool = True

    bot: telebot.TeleBot
    phishing_keyboard_factory: CallbackData
    BASE_API_URL = "http://api.phishstats.info/api/phishing"

    def set_handlers(self, bot: telebot.TeleBot):
        """Set message handlers"""
        self.bot = bot
        self.phishing_keyboard_factory = CallbackData('action', prefix=self.commands[0])

        @bot.message_handler(commands=self.commands)
        def phishing_message_handler(message: types.Message):
            args = message.text.split()[1:]
            
            if not args:
                bot.send_message(
                    message.chat.id,
                    "Используйте:\n"
                    "/phishing latest [N]\n"
                    "/phishing country [CODE] [N]",
                    reply_markup=self.__gen_main_markup()
                )
                return

            try:
                if args[0] == "latest":
                    count = int(args[1]) if len(args) > 1 else 5
                    data = self.__get_phishing_data({'_sort': '-id', '_size': count})
                    response = self.__format_response(data, f"Последние {count} фишинговых сайтов:")
                    
                elif args[0] == "country":
                    if len(args) < 2:
                        bot.send_message(message.chat.id, "Укажите код страны")
                        return
                    country = args[1].upper()
                    count = int(args[2]) if len(args) > 2 else 5
                    data = self.__get_phishing_data({'country': country, '_sort': '-id', '_size': count})
                    response = self.__format_response(data, f"Сайты в {country}:")
                    
                else:
                    bot.send_message(message.chat.id, "Неизвестная команда")
                    return

                bot.send_message(
                    message.chat.id,
                    response,
                    reply_markup=self.__gen_main_markup(),
                    parse_mode='HTML'
                )

            except Exception as e:
                logging.error(f"Error: {e}")
                bot.send_message(message.chat.id, f"Ошибка: {e}")

        @bot.callback_query_handler(func=None, config=self.phishing_keyboard_factory.filter())
        def phishing_keyboard_callback(call: types.CallbackQuery):
            callback_data: dict = self.phishing_keyboard_factory.parse(callback_data=call.data)
            action = callback_data['action']

            if action == "latest":
                data = self.__get_phishing_data({'_sort': '-id', '_size': 5})
                response = self.__format_response(data, "Последние 5 сайтов:")
                self.bot.edit_message_text(
                    chat_id=call.message.chat.id,
                    message_id=call.message.message_id,
                    text=response,
                    reply_markup=self.__gen_main_markup(),
                    parse_mode='HTML'
                )
            elif action == "help":
                self.bot.send_message(
                    call.message.chat.id,
                    self.description,
                    reply_markup=self.__gen_main_markup()
                )

    def __get_phishing_data(self, params=None):
        try:
            response = requests.get(self.BASE_API_URL, params=params, timeout=10)
            response.raise_for_status()
            return response.json()
        except requests.exceptions.RequestException as e:
            logging.error(f"API Error: {e}")
            return None

    def __format_response(self, data, title):
        if not data:
            return "Данные не найдены"
        
        result = [f"<b>{title}</b>\n"]
        for item in data:
            result.append(
                f"🔗 <a href='{item.get('url', '')}'>{item.get('url', 'N/A')}</a>\n"
                f"🌍 {item.get('country', 'N/A')} | "
                f"📅 {item.get('date', 'N/A')}\n"
            )
        return "\n".join(result)

    def __gen_main_markup(self):
        markup = types.InlineKeyboardMarkup()
        markup.row_width = 2
        
        latest_callback = self.phishing_keyboard_factory.new(action="latest")
        help_callback = self.phishing_keyboard_factory.new(action="help")
        
        markup.add(
            types.InlineKeyboardButton("Последние 5", callback_data=latest_callback),
            types.InlineKeyboardButton("Помощь", callback_data=help_callback)
        )
        return markup
